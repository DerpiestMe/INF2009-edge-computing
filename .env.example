# MQTT broker (cloud/laptop)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# InfluxDB client settings (cloud_subscriber)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-token
INFLUX_ORG=edge-computing
INFLUX_BUCKET=edge-computing

# Alert history API + snapshot storage
ALERTS_DB_PATH=cloud/data/alerts.jsonl
CLOUD_SNAPSHOT_DIR=cloud_snapshots

# Whitelist re-identification
WHITELIST_DIR=cloud/whitelist
REID_THRESHOLD=0.6
